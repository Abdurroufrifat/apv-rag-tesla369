{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/sciattr369-claim-record.schema.json",
  "title": "SciAttr-369 Claim Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "canonical_claim_id",
    "claim_text",
    "claimed_person",
    "claim_type",
    "language",
    "verdict",
    "verdict_confidence",
    "sufficiency",
    "source_urls",
    "provenance_family_ids",
    "review_status",
    "annotator_id",
    "notes"
  ],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]*$"},
    "canonical_claim_id": {"type": "string", "minLength": 1},
    "claim_text": {"type": "string", "minLength": 10},
    "claimed_person": {"type": "string", "minLength": 1},
    "claim_type": {
      "type": "string",
      "enum": ["quotation", "discovery", "belief", "behavior", "prediction", "other"]
    },
    "language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"},
    "verdict": {
      "type": "string",
      "enum": ["authenticated", "misattributed", "contradicted", "insufficient"]
    },
    "verdict_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "sufficiency": {"type": "string", "enum": ["sufficient", "insufficient"]},
    "source_urls": {"type": "string"},
    "provenance_family_ids": {"type": "string"},
    "review_status": {"type": "string", "enum": ["candidate", "pilot", "reviewed", "adjudicated"]},
    "annotator_id": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  }
}

