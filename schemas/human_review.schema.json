{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/sciattr369-human-review.schema.json",
  "title": "SciAttr-369 Phase 1C Frozen Human Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "claim_id",
    "reviewer_code",
    "bilingual_qualification",
    "independent_review_confirmed",
    "review_date",
    "canonical_claim",
    "source_url",
    "source_identifier",
    "article_title",
    "source_date",
    "printed_page",
    "column",
    "serbian_transcription",
    "literal_translation",
    "normalized_english",
    "translation_equivalence",
    "verdict",
    "sufficiency",
    "confidence",
    "decisive_evidence_ids",
    "provenance_family_ids",
    "rationale",
    "missing_evidence",
    "limitations",
    "frozen",
    "frozen_at_utc",
    "protocol_version"
  ],
  "properties": {
    "review_id": {"type": "string", "pattern": "^REVIEW-T369-[0-9]{3,}-[AB]$"},
    "claim_id": {"type": "string", "pattern": "^T369-[0-9]{3,}$"},
    "reviewer_code": {"type": "string", "pattern": "^R[AB]-[A-Z0-9]{4,}$"},
    "bilingual_qualification": {"const": true},
    "independent_review_confirmed": {"const": true},
    "review_date": {"type": "string", "format": "date"},
    "canonical_claim": {"type": "string", "minLength": 20},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "source_identifier": {"type": "string", "minLength": 10},
    "article_title": {"type": "string", "minLength": 5},
    "source_date": {"type": "string", "format": "date"},
    "printed_page": {"type": "integer", "minimum": 1},
    "column": {"type": "integer", "minimum": 1},
    "serbian_transcription": {"type": "string", "minLength": 40},
    "literal_translation": {"type": "string", "minLength": 20},
    "normalized_english": {"type": "string", "minLength": 20},
    "translation_equivalence": {
      "enum": ["exact", "materially_equivalent", "non_equivalent", "uncertain"]
    },
    "verdict": {
      "enum": ["authenticated", "misattributed", "contradicted", "insufficient"]
    },
    "sufficiency": {"enum": ["sufficient", "insufficient"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "decisive_evidence_ids": {"type": "string", "minLength": 8},
    "provenance_family_ids": {"type": "string", "minLength": 4},
    "rationale": {"type": "string", "minLength": 80},
    "missing_evidence": {"type": "string"},
    "limitations": {"type": "string"},
    "frozen": {"const": true},
    "frozen_at_utc": {"type": "string", "format": "date-time"},
    "protocol_version": {"const": "0.2"}
  }
}
